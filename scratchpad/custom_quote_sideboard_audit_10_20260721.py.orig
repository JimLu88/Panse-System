# -*- coding: utf-8 -*-
"""10 sideboard custom-quote cases: two system cards + independent Codex board model.

Read-only. The independent price does NOT reuse quote_both.custom_boards or its final price.
It starts from an exact real SKU daily price, then adds the delta between a manually modelled
baseline board list and a manually modelled target board list, using ERP material/config data.
"""
from __future__ import annotations

import json
import sys
from pathlib import Path

