def area_part(part, material, length_cm, width_cm, qty=1):
    return {"part": part, "material": material, "length_cm": length_cm,
            "width_cm": width_cm, "qty": qty, "unit": "平方米", "is_accessory": True}


def each_part(part, material, qty=1):
    return {"part": part, "material": material, "length_cm": 0, "width_cm": 0,
            "qty": qty, "unit": "个", "is_accessory": True}


