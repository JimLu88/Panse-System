def model_boards(dims, spec):
    length, depth, height = dims
    # 与生产保护规则一致：默认松木抽屉围板无价时，保守用柜体主材，不按0元。
    boards = tpl.generate_boards(
        "餐边柜", length * 100, depth_cm=depth, height_cm=height,
        cols=spec["cols"], drawers=spec["drawers"], doors=spec["doors"],
        shelves=spec["shelves"], main_material=spec["material"],
        drawer_material=spec["material"])
    boards.extend([dict(x) for x in spec.get("extras", [])])
    return boards


def missing_prices(db, boards):
    cfg = ccfg.get_config(db)
    missing = []
    for b in boards:
        if float(ccfg.lookup_price(cfg, b.get("material", ""), db=db) or 0) <= 0:
            missing.append(b.get("material") or b.get("part"))
    return sorted(set(missing))


def heavy(db, dims, boards):
    length, depth, height = dims
    return v2.quote_heavy(db, product_type="餐边柜", length_m=length, boards=boards,
                          overall_width_m=depth / 100, overall_height_m=height / 100)


def run_case(db, i, c):
    product = db.query(Product).filter(Product.code == c["code"]).first()
    sku = db.query(PricingSku).filter(PricingSku.sku_code == c["sku"]).first()
    add = c.get("add", [])
    remove = c.get("remove", [])
    modify = c.get("modify", [])
    both = v2.quote_both(
        db, base_product_code=c["code"], base_sku_code=c["sku"],
        category=product.category, target_length_m=c["dims"][0],
        target_width_cm=c["dims"][1], target_height_cm=c["dims"][2],
        target_material=c.get("material"), add_parts=add, remove_parts=remove,
        modify_parts=modify, price_tier="daily", description=c["request"])

    # Check whether system card 2 changes when only the structural request is removed.
    paint_only = [p for p in add if v2._is_paint_part(p)]
    plain = v2.quote_both(
        db, base_product_code=c["code"], base_sku_code=c["sku"], category=product.category,
        target_length_m=c["dims"][0], target_width_cm=c["dims"][1],
        target_height_cm=c["dims"][2], add_parts=paint_only,
        price_tier="daily", description="")
    sys1 = (both.get("spec") or {}).get("final_price")
    sys2 = (both.get("custom") or {}).get("final_price")
    plain2 = (plain.get("custom") or {}).get("final_price")
    structural_add = [p for p in add if not v2._is_paint_part(p)]
    ignored = bool((structural_add or remove or modify or c.get("material")) and sys2 is not None and plain2 is not None
                   and abs(float(sys2) - float(plain2)) < 0.01)
    def board_summary(result):
        out = {}
        for b in result.get("custom_boards") or []:
            key = f"{b.get('part')}|{b.get('material')}"
            out[key] = out.get(key, 0) + float(b.get("qty", 1) or 1)
        return out

    base_boards = model_boards(c["base_dims"], c["base"])
    target_boards = model_boards(c["dims"], c["target"])
    missing = missing_prices(db, target_boards)
    base_model = heavy(db, c["base_dims"], base_boards)
    target_model = heavy(db, c["dims"], target_boards)
    paint = 0.0
    if c.get("paint"):
        cfg = ccfg.get_config(db)
        paint = v2._paint_surcharge(cfg, category="餐边柜", length_m=c["dims"][0],
                                    depth_cm=c["dims"][1], height_cm=c["dims"][2])[0]
    base_model_price = base_model.get("final_price")
    target_model_price = target_model.get("final_price")
    structure_delta = None
    if base_model_price is not None and target_model_price is not None:
        structure_delta = round(float(target_model_price) - float(base_model_price) + paint, 2)
    independent = None
    if sku and sku.daily_price is not None and not missing and structure_delta is not None:
        independent = round(float(sku.daily_price) + structure_delta, 2)

    unpriced = sorted({p.get("material") or p.get("name") for p in ((both.get("spec") or {}).get("parts_detail") or [])
                       if not p.get("priced")})
    failures, warnings = [], []
    if ignored:
        failures.append("系统卡2未计入结构/材质变化")
    if unpriced:
        note = "系统卡1缺价物料: " + "、".join(unpriced)
        (failures if sys1 is not None else warnings).append(note)
    if missing:
        note = "独立核算缺物料价: " + "、".join(missing)
        (failures if (sys1 is not None or sys2 is not None) else warnings).append(note)
    if sys1 and independent and abs(float(sys1) - independent) / independent > 0.15:
        diff = (float(sys1) - independent) / independent
        warnings.append(f"系统卡1与独立核算相差{diff:+.1%}")
    outcome = "失败" if failures else ("安全停止" if sys1 is None and sys2 is None else "通过")
    return {
        "序号": i, "来源": c["origin"], "产品": product.name, "基准SKU": sku.sku,
        "需求": c["request"], "假设": c["assumption"],
        "系统卡1": sys1, "系统卡2": sys2, "空白卡2": plain2, "独立核算价": independent,
        "卡2板单": board_summary(both), "空白板单": board_summary(plain),
        "独立基准板单价": base_model_price, "独立目标板单价": target_model_price,
        "独立结构差额": structure_delta,
        "系统卡2忽略需求": ignored, "系统卡1零价物料": unpriced, "独立缺价物料": missing,
        "警告": warnings,
        "结论": outcome if not failures else "；".join(failures),
    }


def main():
    db = SessionLocal()
    try:
        rows = [run_case(db, i, c) for i, c in enumerate(CASES, 1)]
    finally:
        db.close()
    Path("/tmp/custom_quote_sideboard_audit_10_20260721.json").write_text(
        json.dumps(rows, ensure_ascii=False, indent=2), encoding="utf-8")
    print(json.dumps({"count": len(rows), "passed": sum(r["结论"] == "通过" for r in rows),
                      "rows": rows}, ensure_ascii=False))


if __name__ == "__main__":
    main()
