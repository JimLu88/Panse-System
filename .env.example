# 复制为 .env 后填值. 不要 commit 真 .env.

# --- Postgres ---
POSTGRES_USER=panse
POSTGRES_PASSWORD=panse_dev_pw          # 生产改强密码
POSTGRES_DB=panse_erp
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- 后端 ---
DATABASE_URL=postgresql+psycopg2://panse:panse_dev_pw@db:5432/panse_erp

# 认证 (plan §10 Phase 6) — 生产 必须 改这个 secret
JWT_SECRET=panse-dev-secret-CHANGE-ME-in-production
JWT_TTL_HOURS=24

# 审计白名单 (逗号分隔, 这些路径的写请求不入 audit_logs)
AUDIT_SKIP_PATHS=/api/health,/api/auth/login

# --- AI 辅助 (plan §7) ---
# 不填则 AI 端点返回友好提示, 不崩
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6

# --- 前端 (Vite) ---
VITE_API_BASE_URL=http://localhost:8000

# --- 生产 (docker-compose.prod.yml) ---
PUBLIC_HOST=erp.example.com
