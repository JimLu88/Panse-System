# 复制为 .env 后填值. 不要 commit 真 .env.

# --- Postgres ---
POSTGRES_USER=panse
POSTGRES_PASSWORD=panse_dev_pw          # 生产改强密码
POSTGRES_DB=panse_erp
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- 后端 ---
DATABASE_URL=postgresql+psycopg2://panse:panse_dev_pw@db:5432/panse_erp

# 认证 — JWT 签名密钥。留空/默认时系统会自动生成随机密钥并持久化到
# storage/.jwt_secret (不再用公开默认密钥签发可被伪造的 token)。如需固定可显式设置。
JWT_SECRET=
JWT_TTL_HOURS=24

# 机密加密密钥 (AI/OCR key、webhook 等静态加密)。留空则用 JWT_SECRET 兜底(向后兼容)。
# 设置独立值可与登录密钥彻底分离; 注意: 设置后需到后台重新录入一次 AI/OCR key。
SETTINGS_ENCRYPTION_KEY=

# 审计白名单 (逗号分隔, 这些路径的写请求不入 audit_logs)
AUDIT_SKIP_PATHS=/api/health,/api/auth/login

# --- AI 辅助 (plan §7) ---
# 不填则 AI 端点返回友好提示, 不崩
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6

# --- 物流查询 (查快递) ---
# provider 选择: kuaidi100 | kdniao | auto (默认 auto: 谁配了用谁, 优先快递100)。
# 也可不填这些环境变量, 改在 管理 → 集成配置 后台填 (加密落库, 无需重启)。
TRACKING_PROVIDER=auto
# 快递100 (免费套餐约 100 次/天): 注册 https://api.kuaidi100.com/ 获取 customer + key
KUAIDI100_CUSTOMER=
KUAIDI100_KEY=
# 快递鸟 (即时查询免费档): 注册 https://www.kdniao.com/ 获取 EBusinessID + ApiKey
KDNIAO_EBUSINESS_ID=
KDNIAO_API_KEY=

# --- 前端 (Vite) ---
VITE_API_BASE_URL=http://localhost:8000

# --- 生产 (docker-compose.prod.yml) ---
PUBLIC_HOST=erp.example.com
# 时区 (全容器统一; 调度/下单图/取数 按北京时间触发)
TZ=Asia/Shanghai

# 群晖路径 (NAS 上指到共享文件夹; PC 本地留默认相对路径即可)
#   群晖示例: STORAGE_DIR=/volume1/docker/panse/storage 等
STORAGE_DIR=./storage                 # 归档/缩略图/上传 (读写)
GALLERY_DIR=./gallery                 # 产品图库 (只读挂载)
BACKUPS_DIR=./backups                 # 数据库备份输出
AGENT_OUTPUT_DIR_HOST=./agent_output  # Web-Agent 产物 (群晖: SMB/NFS 挂 Windows 共享)

# Web-Agent (浏览器自动取数, 跑在 Windows PC). 群晖部署填 PC 局域网 IP, 如 http://192.168.x.x:8500. 空=不连
WEB_AGENT_URL=
# 绘图子程序 (独立部署, 见 docs/绘图子程序_交接方案.md). 空=不出图纸, 不报错
DRAWING_SERVICE_URL=
