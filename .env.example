# 复制为 .env 后填值. 不要 commit 真 .env.

# --- Postgres ---
POSTGRES_USER=panse
POSTGRES_PASSWORD=panse_dev_pw          # 生产改强密码
POSTGRES_DB=panse_erp
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- 后端 ---
DATABASE_URL=postgresql+psycopg2://panse:panse_dev_pw@db:5432/panse_erp

# 认证 — JWT 签名密钥。留空/默认时系统会自动生成随机密钥并持久化到
# storage/.jwt_secret (不再用公开默认密钥签发可被伪造的 token)。如需固定可显式设置。
JWT_SECRET=
JWT_TTL_HOURS=24

# 机密加密密钥 (AI/OCR key、webhook 等静态加密)。留空则用 JWT_SECRET 兜底(向后兼容)。
# 设置独立值可与登录密钥彻底分离; 注意: 设置后需到后台重新录入一次 AI/OCR key。
SETTINGS_ENCRYPTION_KEY=

# 审计白名单 (逗号分隔, 这些路径的写请求不入 audit_logs)
AUDIT_SKIP_PATHS=/api/health,/api/auth/login

# --- AI 辅助 (plan §7) ---
# 不填则 AI 端点返回友好提示, 不崩
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6

# --- 前端 (Vite) ---
VITE_API_BASE_URL=http://localhost:8000

# --- 生产 (docker-compose.prod.yml) ---
PUBLIC_HOST=erp.example.com
