# Copy to .env for docker-compose. Never commit the real .env.
POSTGRES_USER=panse
POSTGRES_PASSWORD=panse_dev_pw
POSTGRES_DB=panse_erp
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Used by backend (read by app.config.Settings)
DATABASE_URL=postgresql+psycopg2://panse:panse_dev_pw@db:5432/panse_erp

# Frontend dev-server reads this through Vite's import.meta.env
VITE_API_BASE_URL=http://localhost:8000
