# 复制为 .env 后按需修改。不配也能跑(默认 mock LLM + sqlite)。

# 数据库(默认 sqlite 本地文件)
DATABASE_URL=sqlite:///./marketing.db

# LLM 提供方: mock(默认,免key) / anthropic / openai
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-fable-5
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Panse-System ERP 对接(线索成交回写,可选)
ERP_BASE_URL=
ERP_TOKEN=
