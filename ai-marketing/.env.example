# 复制为 .env 后按需修改。不配也能跑(默认 mock LLM + sqlite)。

# 数据库(默认 sqlite 本地文件)
DATABASE_URL=sqlite:///./marketing.db

# LLM 提供方: mock(默认,免key) / anthropic / openai
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-fable-5
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Panse-System ERP 对接(线索成交回写,可选; 未配则用 /api/leads/export 导CSV对账)
ERP_BASE_URL=
ERP_TOKEN=

# 简单鉴权: 配了则 /api/* 需 Bearer token (内网默认留空免鉴权)
API_TOKEN=

# 看门狗: 60s体检, 连续3次失败 SIGTERM 自救(配合 Docker unless-stopped). 默认开
WATCHDOG_ENABLED=1

# 飞书群机器人 webhook(看门狗告警/超期线索/到点发布 推送). 留空则不推送
FEISHU_WEBHOOK_URL=

# 真实数据源(AI数据爬虫,挂载项A). 配了则评论引流用真实上升笔记, 否则演示数据
CRAWLER_BASE_URL=
