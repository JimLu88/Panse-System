# Copy to deploy/fuge/.env on the NAS. Keep this file private.
FUGE_DATA_ROOT=/volume1/docker/panse-fuge
FUGE_BIND_IP=0.0.0.0
FUGE_POSTGRES_USER=fuge
FUGE_POSTGRES_DB=fuge_erp
FUGE_POSTGRES_PASSWORD=replace-with-a-long-random-password
FUGE_JWT_SECRET=replace-with-a-different-long-random-secret
FUGE_SETTINGS_ENCRYPTION_KEY=replace-with-a-third-long-random-secret
FUGE_PUBLIC_ORIGIN=http://192.168.31.21:8290
PANSE_PUBLIC_ORIGIN=http://192.168.31.21:8200
FUGE_SHOP_NAME=孚格家具
# Keep external integrations off until 孚格's own platform accounts are configured.
FUGE_DISABLE_SCHEDULER=1
FUGE_DISABLE_WATCHDOG=0
