        {
          "start": 0,
          "end": 0,
          "before": [],
          "after": [
            "\"\"\"Register exact shared artifact before requesting its platform password once.\"\"\"",
            "import hashlib",
            "import json",
            "import urllib.request",
            "from datetime import timedelta, timezone",
            "from pathlib import Path",
            "",
            "from app import config",
            "",
            "",
            "def register(path, *, export_id, applied_at, variables):",
            "    from app.engine.erp_notify import ERP_URL",
            "    from app.vault.store import get_or_create_api_token",
            "    artifact = Path(path).resolve()",
            "    relative = artifact.relative_to(config.OUTPUT_DIR.resolve()).as_posix()",
            "    if applied_at.tzinfo is None:",
            "        applied_at = applied_at.replace(tzinfo=timezone(timedelta(hours=8)))",
            "    recovery = variables.get('_shipping_recovery') or {}",
            "    manifest = {'path': relative, 'sha256': hashlib.sha256(artifact.read_bytes()).hexdigest(),",
            "                'export_id': export_id, 'generated_at': applied_at.isoformat(),",
            "                'business_date': variables.get('order_business_date'),",
            "                'order_batch_id': variables.get('order_batch_id'),",
            "                'mode': 'independent' if recovery else 'original',",
            "                'source_file_ids': recovery.get('source_file_ids', []),",
            "                'sub_order_nos': recovery.get('sub_order_nos', [])}",
            "    if not manifest['business_date'] or not manifest['order_batch_id']:",
            "        raise ValueError('shipping_registration_business_identity_missing')",
            "    req = urllib.request.Request(ERP_URL + '/api/web-agent/shipping-target',",
            "            data=json.dumps(manifest).encode(), headers={'Content-Type': 'application/json',",
            "            'X-API-Key': get_or_create_api_token()})",
            "    # No retry: an unknown registration may already have claimed password send.",
            "    with urllib.request.urlopen(req, timeout=30) as response:",
            "        result = json.loads(response.read())",
            "    if result.get('ok') is not True:",
            "        raise ValueError('shipping_registration_not_confirmed')",
            "    return result"
          ]
        }
      ]
